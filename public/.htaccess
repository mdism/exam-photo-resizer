# Security and caching rules for a free tool on shaikhismail.com (Apache / LiteSpeed on cPanel).
# The tool is static: no forms, no uploads, no server code. These rules keep it that way.

# ---------- Basics ----------
Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Only GET and HEAD make sense for a static page; refuse everything else (POST spam, PUT, TRACE...).
  # The one exception is the bot-check endpoint, which takes a POST with the Turnstile token.
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
  RewriteCond %{REQUEST_URI} !^/api/verify\.php$
  RewriteRule ^ - [F]

  # Hide dotfiles and folders (.git, .cpanel.yml, .env) except /.well-known
  RewriteRule (^|/)\.(?!well-known/) - [F]

  # Block common vulnerability scanners and junk probes (no WordPress here; the only PHP file is api/verify.php)
  RewriteCond %{REQUEST_URI} !^/api/verify\.php$
  RewriteRule \.(php\d?|phtml|asp|aspx|jsp|cgi|env|ini|sql|bak|old|log|sh|yml|yaml|md)$ - [F,NC]
  RewriteRule ^(wp-admin|wp-login|wp-content|wp-includes|xmlrpc|phpmyadmin|cgi-bin|vendor/phpunit) - [F,NC]

  # Block bots that ignore robots.txt or only scrape/scan
  RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|zgrab|acunetix|nessus|wpscan|dirbuster|gobuster|httrack|python-requests|go-http-client|libwww-perl|curl/|wget/|MJ12bot|AhrefsBot|SemrushBot|DotBot|PetalBot|BLEXBot) [NC]
  RewriteRule ^ - [F]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  # Only load code, styles, fonts and images from this site, plus Cloudflare Turnstile (the bot check).
  # The page may only talk back to this site (the bot-check token), so files and inputs cannot be sent anywhere.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always unset X-Powered-By
  Header unset ETag

  # Cache versioned assets for a year, but always re-check the page itself
  <FilesMatch "\.(css|js|woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
FileETag None

# ---------- Correct types and compression ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType text/javascript .js
  AddCharset utf-8 .html .css .js .txt
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain image/svg+xml
</IfModule>
